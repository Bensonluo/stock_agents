# Database
DATABASE_URL=postgresql://admin:your_password@localhost:5432/stockdb

# Checkpoint persistence: auto | sqlite | postgres | memory
# auto = postgres when DATABASE_URL is set, else durable sqlite
CHECKPOINT_BACKEND=auto
CHECKPOINT_DB_PATH=data/checkpoints.db
REDIS_URL=redis://localhost:6379

# API Keys (if using paid services)
# TUSHARE_TOKEN=your_tushare_token
# ALPHA_VANTAGE_KEY=your_alpha_vantage_key
# FINNHUB_API_KEY=your_finnhub_api_key
# Get free key from: https://finnhub.io/ (60 req/min free tier)

# CN options implied-signal layer: SSE options trio + QVIX market-level
# annotation for CN runs (pure label — no scoring reads it)
OPTION_SIGNALS_ENABLED=true

# CN analyst-consensus annotation for A-shares (EPS forecasts, target
# prices, rating counts — pure annotation, no scoring reads it)
CONSENSUS_ENABLED=true

# Multi-period fundamental trend depth: CN runs carry the full Sina
# indicator history, US/HK runs the three quarterly statements; the
# analysis seam emits a per-symbol trend block (pure annotation, no
# scoring reads it)
TREND_DEPTH_ENABLED=true

# LLM Configuration
# For GLM-4 models (Zhipu AI) - Recommended for Chinese users
ZHIPUAI_API_KEY=your_zhipuai_api_key
# Get your API key from: https://open.bigmodel.cn/

# Optional: OpenAI (fallback)
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# LLM Model Selection (GLM models)
# glm-5.3-flash - Fast and cost-effective (current default)
# glm-5.2 - Most capable (slower)
# glm-5.2 - Standard model
PRIMARY_LLM_MODEL=glm-5.3-flash
SECONDARY_LLM_MODEL=glm-5.3-flash
BATCH_LLM_MODEL=glm-5.3-flash

# LLM Parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
# HTTP ceiling for every LLM client — research enhancement budgets below must
# stay at/below this or their wait_for budget is decorative (client cuts first)
LLM_TIMEOUT=90

# Optional LLM narrative overlay on pipeline reports (bounded + graceful degradation)
REPORT_LLM_ENABLED=false
REPORT_LLM_TIMEOUT=60

# Research synthesis LLM enhancement budgets (measured glm-5.3-flash latency:
# narrator 33.6s, panel 36.6/41.6/47/>60s — a 60s panel budget cut ~1/4 of runs)
NARRATION_TIMEOUT_SECONDS=45
PANEL_TIMEOUT_SECONDS=90

# Optional LLM semantic scoring of news headlines (keyword scorer stays the floor)
LLM_SENTIMENT_ENABLED=false

# Optional LLM-as-judge for report eval runs (deterministic rubric always runs)
EVAL_LLM_JUDGE=false

# JWT Secret
JWT_SECRET=your_jwt_secret_change_this_in_production

# Application Settings
LOG_LEVEL=INFO
MAX_RETRIES=3
TIMEOUT_PER_AGENT=300
PARALLEL_EXECUTION=true

# Per-tool-invocation wall clock in the ReAct loop. A tool whose internal
# upstream call hangs never raises — this bound keeps the loop (and its
# analysis-capacity slot) from stalling forever. 0 disables.
REACT_TOOL_TIMEOUT=120

# Overall wall clock for one ReAct run. Iterations are capped and each tool
# call bounded (above), but the worst-case bounded run still holds an
# analysis-capacity slot for tens of minutes. 0 disables.
REACT_RUN_TIMEOUT=900

# Overall wall clock for one pipeline run (the pipeline twin of the knob
# above — every node is bounded, but nodes x budget x retries is still
# tens of minutes). 0 disables.
PIPELINE_RUN_TIMEOUT=1800

# Daily watchlist auto-run (opt-in scheduler, disabled by default).
# When enabled, one analysis workflow per calendar day at DAILY_RUN_TIME
# (server local time) over DAILY_RUN_SYMBOLS, persisted to analysis_history
# like a manual run — feeds the IC/calibration evidence base without
# hand-triggering. Max one run per day (a record for today's daily-* thread
# means it already ran, restart-safe); if the server was down at trigger
# time it catches up on the same-day restart. Invalid DAILY_RUN_TIME
# disables the scheduler with an error log at startup.
DAILY_RUN_ENABLED=false
# Cross-sector CN default (IC views need >=3 scored symbols per run; US
# symbols sit behind Yahoo-429 on the server and shrink the cross-section)
DAILY_RUN_SYMBOLS=600519,600036,601088,600276,002415,600887
# 16:00 ≈ after the A-share close, overnight US session decided
DAILY_RUN_TIME=16:00

# Analysis knobs
# Annual cash rate for excess-return alpha (Jensen's); T-bill level, deliberately not fetched
RISK_FREE_RATE_ANNUAL=0.04
# Liquidity floors for the ADV annotation layer (daily dollar volume thresholds)
MIN_ADV_USD=2000000
MIN_ADV_CNY=20000000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# CORS
FRONTEND_URL=http://localhost:3000

# Rate limiting — in-process sliding window per client IP on the expensive
# POST endpoints (analysis/agent analyze + backtest); GET endpoints unlimited.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYSIS_LIMIT=10
RATE_LIMIT_ANALYSIS_WINDOW_SECONDS=600
RATE_LIMIT_BACKTEST_LIMIT=30
RATE_LIMIT_BACKTEST_WINDOW_SECONDS=600

# Global cap on concurrently running analysis workflows (the rate limiter
# bounds one client; this bounds the server total). 0 disables.
MAX_CONCURRENT_ANALYSES=2

# Cap on symbols per analyze request (request size — the last unbounded
# input axis). 0 disables.
MAX_SYMBOLS_PER_REQUEST=10

# App identity & debug flag
APP_NAME=Stock Analysis Multi-Agent System
APP_VERSION=0.1.0
DEBUG=false

# Data-source toggles — AKSHARE_ENABLED is wired (gates every akshare
# collection leg); YFINANCE_ENABLED / FINNHUB_ENABLED are declared but not
# yet wired (reserved, no runtime effect)
YFINANCE_ENABLED=true
AKSHARE_ENABLED=true
FINNHUB_ENABLED=true
US_QUARTERLY_EM_ENABLED=true
EVENTS_ENABLED=true

# CORS allow-list (JSON list; FRONTEND_URL above is the frontend origin)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]

# Auth token algorithm/lifetime (JWT_SECRET above)
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# Resilience: circuit breaker trips + monitoring alert thresholds
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=300
ALERT_HEALTH_SCORE_THRESHOLD=70.0
ALERT_SUCCESS_RATE_THRESHOLD=0.95
ALERT_EXECUTION_TIME_THRESHOLD=30.0

# Backtest cost model & executor pool
BACKTEST_INITIAL_CASH=10000.0
BACKTEST_COMMISSION=0.001
BACKTEST_EXECUTOR_WORKERS=2

# Cache TTL (seconds) and reasoning-agent budgets
CACHE_TTL=300
AGENT_MAX_ITERATIONS=15
AGENT_COST_LIMIT=0.5
AGENT_REASONING_MODEL=glm-5.3-flash

# IC adaptive weighting (calibration path)
IC_ADAPTIVE_WEIGHTS_ENABLED=true
